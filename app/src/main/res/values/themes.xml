<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Modern Android 12+ / Jetpack Splash Screen Theme -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Background color of the splash screen -->
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <!-- App icon displayed on the splash screen -->
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <!-- The theme of the Activity that immediately follows the splash screen -->
        <item name="postSplashScreenTheme">@style/Theme.MyApplication</item>
    </style>

    <style name="Theme.MyApplication" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/splash_background</item>
    </style>
</resources>
